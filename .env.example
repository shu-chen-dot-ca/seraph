# GitHub tokens for search, read access to public repos is enough. More: GITHUB_TOKEN_4, GITHUB_TOKEN_5, ...
GITHUB_TOKEN=
GITHUB_TOKEN_2=
GITHUB_TOKEN_3=

# Claude Code logins from `claude setup-token`: the agents', and Fix all's.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN_VM=

BACKEND_PORT=8001
DATA_DIR=data
# This repo on GitHub (owner/name). deploy/install.sh sets it.
SERAPH_REPO=

# Remote access (remote_access/README.md). Empty: only this computer can open the app.
REMOTE_ACCESS_DOMAIN=
REMOTE_ACCESS_SERVER=
